# Copy this file to .env and add your own key. Never put this key in app.py.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: select a model available to your OpenAI project.
OPENAI_MODEL=gpt-5.6

# MongoDB Atlas or local MongoDB URI. Keep this secret and never commit .env.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=campusflow
